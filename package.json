                    "preview":  "vite preview",
                    "audit":  "npm audit --audit-level=info",
                    "lint":  "tsc --noEmit",
                    "test":  "node --import tsx --test tests/*.test.ts",
                    "check":  "npm run audit \u0026\u0026 npm run lint \u0026\u0026 npm test",
                    "verify":  "npm run check \u0026\u0026 npm run build"
                },
