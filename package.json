    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "allowScripts":  {
                         "esbuild@0.28.1":  true,
                         "fsevents@2.3.3":  true
                     },
    "scripts":  {
                    "dev":  "vite",
                    "dev:raw":  "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
